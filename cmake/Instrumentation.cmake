option(FLUXCRAWL_WARNINGS_AS_ERRORS "Treat project warnings as errors" OFF)
option(FLUXCRAWL_ENABLE_FUZZING "Build Clang libFuzzer parser targets" OFF)
set(FLUXCRAWL_SANITIZER "none" CACHE STRING "none, address-undefined, or thread")
set_property(CACHE FLUXCRAWL_SANITIZER PROPERTY STRINGS none address-undefined thread)
if(FLUXCRAWL_ENABLE_FUZZING)
    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
        message(FATAL_ERROR "libFuzzer requires Clang; use a separate Clang build")
    endif()
    if(FLUXCRAWL_SANITIZER STREQUAL "thread")
        message(FATAL_ERROR "Fuzzing cannot be combined with ThreadSanitizer")
    endif()
    set(FLUXCRAWL_SANITIZER "address-undefined")
    add_compile_options(-fsanitize=fuzzer-no-link)
endif()
if(NOT FLUXCRAWL_SANITIZER STREQUAL "none")
    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
        message(FATAL_ERROR "Selected sanitizer requires GCC or Clang")
    endif()
    if(FLUXCRAWL_SANITIZER STREQUAL "address-undefined")
        set(fluxcrawl_sanitize address,undefined)
    elseif(FLUXCRAWL_SANITIZER STREQUAL "thread")
        set(fluxcrawl_sanitize thread)
    else()
        message(FATAL_ERROR "Unknown FLUXCRAWL_SANITIZER")
    endif()
    add_compile_options(-fsanitize=${fluxcrawl_sanitize} -fno-omit-frame-pointer)
    add_link_options(-fsanitize=${fluxcrawl_sanitize})
endif()
