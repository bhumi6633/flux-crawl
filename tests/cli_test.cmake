set(expected_status 1)
set(expected_stdout "")
if(CASE STREQUAL "help")
    set(arguments --help)
    set(expected_status 0)
elseif(CASE STREQUAL "version")
    set(arguments --version)
    set(expected_status 0)
    set(expected_stdout "FluxCrawl 0.1.0-dev\n")
elseif(CASE STREQUAL "invalid" OR CASE STREQUAL "help_invalid")
    set(arguments --not-an-option)
    if(CASE STREQUAL "help_invalid")
        list(PREPEND arguments --help)
    endif()
    set(expected_error "unknown option '--not-an-option'")
elseif(CASE STREQUAL "seed")
    set(arguments --max-pages 0 https://example.com)
    set(expected_status 0)
    set(expected_seed "https://example.com/")
elseif(CASE STREQUAL "normalized_seed")
    set(arguments --max-pages 0 "https://EXAMPLE.com:443/docs/../guide#intro")
    set(expected_status 0)
    set(expected_seed "https://example.com/guide")
elseif(CASE STREQUAL "bad_depth")
    set(arguments --depth abc)
    set(expected_error "--depth requires a non-negative integer")
elseif(CASE STREQUAL "negative_pages")
    set(arguments --max-pages -1)
    set(expected_error "--max-pages requires a non-negative integer")
elseif(CASE STREQUAL "overflow_depth")
    set(arguments --depth 999999999999999999999999999999999)
    set(expected_error "--depth requires a non-negative integer")
elseif(CASE STREQUAL "missing_value")
    set(arguments --max-pages)
    set(expected_error "--max-pages requires a non-negative integer")
elseif(CASE STREQUAL "bad_engine" OR CASE STREQUAL "missing_engine")
    set(arguments --engine)
    if(CASE STREQUAL "bad_engine")
        list(APPEND arguments unknown)
    endif()
    set(expected_error "--engine requires sequential, threaded, or async")
elseif(CASE STREQUAL "zero_workers")
    set(arguments --engine threaded --workers 0)
    set(expected_error "--workers must be greater than zero")
elseif(CASE STREQUAL "irrelevant_workers")
    set(arguments --workers 4)
    set(expected_error "--workers requires --engine threaded")
elseif(CASE STREQUAL "negative_workers" OR CASE STREQUAL "overflow_workers" OR CASE STREQUAL "missing_workers")
    set(arguments --engine threaded --workers)
    if(CASE STREQUAL "negative_workers")
        list(APPEND arguments -1)
    elseif(CASE STREQUAL "overflow_workers")
        list(APPEND arguments 999999999999999999999999999999999)
    endif()
    set(expected_error "--workers requires a non-negative integer")
elseif(CASE STREQUAL "zero_concurrency")
    set(arguments --engine async --concurrency 0)
    set(expected_error "--concurrency must be greater than zero")
elseif(CASE STREQUAL "async_workers")
    set(arguments --engine async --workers 4)
    set(expected_error "--workers requires --engine threaded")
elseif(CASE STREQUAL "irrelevant_concurrency" OR CASE STREQUAL "threaded_concurrency")
    set(arguments --concurrency 4)
    if(CASE STREQUAL "threaded_concurrency")
        list(APPEND arguments --engine threaded)
    endif()
    set(expected_error "--concurrency requires --engine async")
elseif(CASE STREQUAL "negative_concurrency" OR CASE STREQUAL "overflow_concurrency" OR CASE STREQUAL "missing_concurrency" OR CASE STREQUAL "bad_concurrency")
    set(arguments --engine async --concurrency)
    if(CASE STREQUAL "negative_concurrency")
        list(APPEND arguments -1)
    elseif(CASE STREQUAL "overflow_concurrency")
        list(APPEND arguments 999999999999999999999999999999999)
    elseif(CASE STREQUAL "bad_concurrency")
        list(APPEND arguments abc)
    endif()
    set(expected_error "--concurrency requires a non-negative integer")
elseif(CASE STREQUAL "async_zero_pages")
    set(arguments --engine async --max-pages 0 https://example.com)
    set(expected_status 0)
    set(expected_stdout "Seed: https://example.com/\nEngine: async\nConcurrency: 8\nMax depth: 2\nMax pages: 0\n\nPage limit reached\nPages attempted: 0\nResponses: 0\nHTML pages processed: 0\nFetch failures: 0\nURLs discovered: 1\nURLs pending: 1\n")
elseif(CASE STREQUAL "invalid_seed" OR CASE STREQUAL "unsupported_seed")
    set(arguments "https:///missing-host")
    if(CASE STREQUAL "unsupported_seed")
        set(arguments "ftp://example.com")
    endif()
    set(expected_error "invalid or unsupported seed URL")
elseif(CASE STREQUAL "missing")
    set(arguments)
    set(expected_error "missing seed URL")
elseif(CASE STREQUAL "extra_seed")
    set(arguments https://example.com https://example.org)
    set(expected_error "expected one non-empty seed URL")
else()
    message(FATAL_ERROR "Unknown CLI test case: ${CASE}")
endif()

execute_process(COMMAND "${FLUXCRAWL}" ${arguments}
    RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr
    TIMEOUT 5)
if(NOT "${status}" STREQUAL "${expected_status}")
    message(FATAL_ERROR "Expected exit ${expected_status}, got ${status}: ${stderr}")
endif()

if(CASE STREQUAL "help")
    foreach(fragment IN ITEMS "FluxCrawl" "Usage:" "fluxcrawl [options] <seed-url>" "--help" "--version" "--depth" "--max-pages" "--same-host" "--engine" "--workers" "--concurrency" "async")
        string(FIND "${stdout}" "${fragment}" position)
        if(position EQUAL -1)
            message(FATAL_ERROR "Help is missing '${fragment}': ${stdout}")
        endif()
    endforeach()
elseif(DEFINED expected_seed)
    set(expected_stdout "Seed: ${expected_seed}\nEngine: sequential\nMax depth: 2\nMax pages: 0\n\nPage limit reached\nPages attempted: 0\nResponses: 0\nHTML pages processed: 0\nFetch failures: 0\nURLs discovered: 1\nURLs pending: 1\n")
    if(NOT "${stdout}" STREQUAL "${expected_stdout}")
        message(FATAL_ERROR "Unexpected zero-page output: ${stdout}")
    endif()
elseif(NOT "${stdout}" STREQUAL "${expected_stdout}")
    message(FATAL_ERROR "Unexpected stdout: ${stdout}")
endif()

if(expected_status EQUAL 0)
    if(NOT "${stderr}" STREQUAL "")
        message(FATAL_ERROR "Unexpected stderr: ${stderr}")
    endif()
else()
    string(FIND "${stderr}" "${expected_error}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing error '${expected_error}': ${stderr}")
    endif()
endif()
