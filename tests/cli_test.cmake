set(expected_status 1)
set(expected_stdout "")
if(CASE STREQUAL "help")
    set(arguments --help)
    set(expected_status 0)
elseif(CASE STREQUAL "version")
    set(arguments --version)
    set(expected_status 0)
    set(expected_stdout "FluxCrawl 0.1.0-dev\n")
elseif(CASE STREQUAL "invalid" OR CASE STREQUAL "help_invalid")
    set(arguments --not-an-option)
    if(CASE STREQUAL "help_invalid")
        list(PREPEND arguments --help)
    endif()
    set(expected_error "unknown option '--not-an-option'")
elseif(CASE STREQUAL "seed")
    set(arguments https://example.com)
    set(expected_error "crawl engine not implemented yet")
elseif(CASE STREQUAL "normalized_seed")
    set(arguments "https://EXAMPLE.com:443/docs/../guide#intro")
    set(expected_error "crawl engine not implemented yet")
elseif(CASE STREQUAL "invalid_seed" OR CASE STREQUAL "unsupported_seed")
    set(arguments "https:///missing-host")
    if(CASE STREQUAL "unsupported_seed")
        set(arguments "ftp://example.com")
    endif()
    set(expected_error "invalid or unsupported seed URL")
elseif(CASE STREQUAL "missing")
    set(arguments)
    set(expected_error "missing seed URL")
elseif(CASE STREQUAL "extra_seed")
    set(arguments https://example.com https://example.org)
    set(expected_error "expected one non-empty seed URL")
else()
    message(FATAL_ERROR "Unknown CLI test case: ${CASE}")
endif()

execute_process(COMMAND "${FLUXCRAWL}" ${arguments}
    RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr
    TIMEOUT 5)
if(NOT "${status}" STREQUAL "${expected_status}")
    message(FATAL_ERROR "Expected exit ${expected_status}, got ${status}: ${stderr}")
endif()

if(CASE STREQUAL "help")
    foreach(fragment IN ITEMS "FluxCrawl" "Usage:" "fluxcrawl [options] <seed-url>" "--help" "--version")
        string(FIND "${stdout}" "${fragment}" position)
        if(position EQUAL -1)
            message(FATAL_ERROR "Help is missing '${fragment}': ${stdout}")
        endif()
    endforeach()
elseif(NOT "${stdout}" STREQUAL "${expected_stdout}")
    message(FATAL_ERROR "Unexpected stdout: ${stdout}")
endif()

if(expected_status EQUAL 0)
    if(NOT "${stderr}" STREQUAL "")
        message(FATAL_ERROR "Unexpected stderr: ${stderr}")
    endif()
else()
    string(FIND "${stderr}" "${expected_error}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing error '${expected_error}': ${stderr}")
    endif()
endif()
